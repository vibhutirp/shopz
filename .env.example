# Copy to .env and fill in. Never commit .env.
# --- AWS (Bedrock for the LLM + embeddings, Polly for the voice) ---
AWS_REGION=us-east-1
# Use an AWS profile or the standard AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY env vars.
AWS_PROFILE=
# Newest Claude model or inference profile enabled in your Bedrock console.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
POLLY_VOICE=Matthew
POLLY_ENGINE=neural
# --- Nova Act (browser agent) ---
NOVA_ACT_API_KEY=
# nova | playwright | headless
BROWSER_MODE=playwright
CONTROLLER_URL=http://localhost:4100
# --- MongoDB Atlas (optional; in-memory store is used when empty) ---
MONGODB_URI=
MONGODB_DB=shopz
# --- Ports ---
AGENT_PORT=3000
RUNHUB_PORT=4001
DAILYCART_PORT=4002
