{
  "manifest_version": 3,
  "name": "Shopz Companion",
  "version": "0.1.0",
  "description": "Lets your Shopz agent use your own browser: it opens and reads pages in one Shopz tab, and hands over to you for sign-in, checks and paying.",
  "minimum_chrome_version": "116",
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Shopz Companion", "default_popup": "popup.html", "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" } },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["tabs", "scripting", "storage", "alarms", "tabGroups"],
  "host_permissions": ["<all_urls>"]
}
